# Copy to .env (repo root) and fill in. Never commit .env.
# Leave DO_INFERENCE_API_KEY empty to run fully offline with the rule parser.

# --- Gemma 4 via DigitalOcean Serverless Inference (server-side only) ---
DO_INFERENCE_API_KEY=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run
# Confirm the exact ID with: cd backend && python scripts/check_inference.py
DO_INFERENCE_MODEL=gemma-4-31B-it
DO_INFERENCE_TIMEOUT_S=20
# DigitalOcean does not document response_format; enable only if verified.
DO_INFERENCE_JSON_MODE=false

# --- Backend ---
# Relative paths resolve from backend/. Docker overrides this with /data/output.
FLOWCAD_OUTPUT_DIR=../output
FLOWCAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# process = CAD in an isolated worker with a timeout; inline = in the API process
FLOWCAD_CAD_ISOLATION=process
FLOWCAD_CAD_TIMEOUT_S=60

# --- Docker Compose ---
FLOWCAD_PORT=8080
